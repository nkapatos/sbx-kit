# Sandbox resource defaults for agents that run a local LLM inside (or beside)
# the sandbox VM. FOLLOW-UP — not wired as the launcher default yet.
#
# Select when ready:
#   sbx-kit run cursor --yes --resources local-llm
#
# Expect higher memory (and often more CPUs / root disk) than remote-llm:
# model weights + KV cache + agent + optional DinD share one VM.
#
# Placeholder values — tune when local-LLM work starts. Overrides still apply:
#   SBX_MEMORY, SBX_CPUS, SBX_ROOT_SIZE, SBX_DOCKER_SIZE

SBX_MEMORY=16g
SBX_CPUS=8
SBX_ROOT_SIZE=40g
SBX_DOCKER_SIZE=50g
