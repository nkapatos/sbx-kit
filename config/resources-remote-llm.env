# Sandbox resource defaults for agents that call remote LLMs (Cursor cloud,
# OpenCode providers, etc.). Applied by sbx-kit run — not by the
# template image (sbx sets CPU/memory/disk at create/run time).
#
# Overrides (any of these win over this file when already set in the environment):
#   SBX_MEMORY, SBX_CPUS, SBX_ROOT_SIZE, SBX_DOCKER_SIZE
#   DOCKER_SANDBOXES_ROOT_SIZE, DOCKER_SANDBOXES_DOCKER_SIZE
#
# Select profile with:
#   sbx-kit run cursor --yes --resources remote-llm   # default
#   sbx-kit run cursor --yes --resources local-llm    # follow-up; see resources-local-llm.env
#
# Existing sandboxes keep the sizes they were created with — recreate to apply
# new memory/CPU/disk defaults.

# VM RAM: enough for agent + light DinD (a couple of containers/DBs).
# Use SBX_MEMORY=2g for agent-only; SBX_MEMORY=8g for heavier local stacks.
SBX_MEMORY=4g

# Compile-friendly without grabbing the whole host (Rust/Go/Elixir benefit).
SBX_CPUS=4

# Sandbox root filesystem (/): apt, /mise installs, home. Upstream default 20g.
SBX_ROOT_SIZE=10g

# Inner Docker data disk (/var/lib/docker): sparse; half of upstream 50g.
# Comfortable for a couple of DB/app images without taxing the host until used.
SBX_DOCKER_SIZE=25g
